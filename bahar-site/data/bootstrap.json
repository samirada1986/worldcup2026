   },
   "blurb": {
    "en": "Photography, perception, and the spaces we inhabit. An ongoing project.",
    "fa": "عکاسی، ادراک و فضاهایی که در آن‌ها زیست می‌کنیم. پروژه‌ای در جریان."
   },
   "tags": {
    "en": "Ongoing project",
    "fa": "پروژه‌ی در جریان"
   },
   "photo_count": 16,
   "cover": {
    "id": 1,
    "index": 0,
    "image_url": "images/shared-border-01.jpg",
    "thumb_url": "images/shared-border-01-thumb.jpg",
    "width": 2400,
    "height": 1698,
    "placeholder": null,
    "plate_no": 1,
    "plate": {
     "en": "Plate 01",
     "fa": "قاب ۰۱"
    },
