# ---------------------------------------------------------------------------
# Samira Dadashi portfolio — environment variables
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgres://postgres@localhost:5432/samira

# Long random string used to sign logins and the contact-form token.
# Generate with:  openssl rand -hex 32
PAYLOAD_SECRET=

# Public address of the site, without trailing slash (used for canonical URLs,
# sitemap, Open Graph and CMS live preview).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# First administrator, created by `npm run seed` on an empty database.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- Optional: S3-compatible object storage for media (AWS S3, Cloudflare R2,
# --- Backblaze B2, MinIO, Arvan Cloud …). Leave S3_BUCKET empty to store
# --- uploads on local disk in ./media
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=media

# --- Optional: SMTP, to email contact-form messages to the address set in
# --- Site settings → Contact form. Messages are always stored in the CMS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Build/dev switches
# BUILD_WITHOUT_DB=1     build without a reachable database (Docker)
# PAYLOAD_DB_PUSH=true   let Payload auto-sync the schema (throwaway DBs only)
# BASE_URL=http://localhost:3000   target for the Playwright test suite
